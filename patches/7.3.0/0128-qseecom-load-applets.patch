+/**
+ * qcom_scm_qseecom_app_load() - Load a QSEE app and return its ID.
+ * @app_name: Name of the app to load.
+ * @sb_size:  Size of the shared buffer the app expects.
+ * @app_id:   Loaded app ID, set on success.
+ *
+ * The mainline QSEECOM support only looks up applets that TZ already holds.
+ * The stock vendor stack loads them on demand instead, and the Xiaomi
+ * ``devauth`` applet - which signs the Pogo keyboard auth token - is not
+ * resident until it is asked for.  This mirrors QSEECom_start_app()'s load
+ * half so a caller can bring an applet in and then talk to it with
+ * qcom_scm_qseecom_app_send().
+ *
+ * The command ID is the one gap in enum qcom_scm_qseecom_tz_cmd_app; if TZ
+ * disagrees the return value is logged so the next boot can correct it.
+ *
+ * Return: 0 on success, negative errno otherwise.
+ */
+int qcom_scm_qseecom_app_load(const char *app_name, size_t sb_size, u32 *app_id)
+{
+	unsigned long name_buf_size = QSEECOM_MAX_APP_NAME_SIZE;
+	unsigned long app_name_len = strlen(app_name);
+	struct qcom_scm_desc desc = {};
+	struct qcom_scm_qseecom_resp res = {};
+	int status;
+
+	if (app_name_len >= name_buf_size)
+		return -EINVAL;
+
+	char *name_buf __free(qcom_tzmem) = qcom_tzmem_alloc(__scm->mempool,
+							     name_buf_size,
+							     GFP_KERNEL);
+	if (!name_buf)
+		return -ENOMEM;
+
+	memcpy(name_buf, app_name, app_name_len);
+
+	desc.owner = QSEECOM_TZ_OWNER_QSEE_OS;
+	desc.svc = QSEECOM_TZ_SVC_APP_MGR;
+	desc.cmd = QSEECOM_TZ_CMD_APP_LOAD;
+	desc.arginfo = QCOM_SCM_ARGS(3, QCOM_SCM_RW, QCOM_SCM_VAL, QCOM_SCM_VAL);
+	desc.args[0] = qcom_tzmem_to_phys(name_buf);
+	desc.args[1] = app_name_len;
+	desc.args[2] = sb_size;
+
+	status = qcom_scm_qseecom_call(&desc, &res);
+
+	if (status) {
+		dev_err(__scm->dev,
+			"qseecom load %s: scm call failed %d\n", app_name, status);
+		return status;
+	}
+
+	if (res.result == QSEECOM_RESULT_FAILURE) {
+		dev_err(__scm->dev,
+			"qseecom load %s: TZ refused (result=%#llx resp_type=%#llx data=%#llx)\n",
+			app_name, res.result, res.resp_type, res.data);
+		return -EIO;
+	}
+
+	if (res.result != QSEECOM_RESULT_SUCCESS) {
+		dev_err(__scm->dev,
+			"qseecom load %s: unexpected result %#llx (resp_type=%#llx data=%#llx)\n",
+			app_name, res.result, res.resp_type, res.data);
+		return -EINVAL;
+	}
+
+	if (res.resp_type != QSEECOM_SCM_RES_APP_ID) {
+		dev_err(__scm->dev,
+			"qseecom load %s: unexpected resp_type %#llx (data=%#llx)\n",
+			app_name, res.resp_type, res.data);
+		return -EINVAL;
+	}
+
+	if (app_id)
+		*app_id = res.data;
+
+	return 0;
+}
+EXPORT_SYMBOL_GPL(qcom_scm_qseecom_app_load);
+
